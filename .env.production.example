# Production environment template. Copy to .env on the VPS and replace
# every CHANGE_ME value before deploying.

APP_ENV=production

WEB_BIND=127.0.0.1
WEB_PORT=4445

WEB_APP_URL=https://priatelia.wondercules.com

DATABASE_URL=postgresql://priatelia:CHANGE_ME_POSTGRES_PASSWORD@database:5432/priatelia
POSTGRES_DB=priatelia
POSTGRES_USER=priatelia
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=43200

SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_FROM=Priatelia <info-priatelia@wondercules.com>
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_STARTTLS=true
SMTP_USE_TLS=false

MEDIA_ENDPOINT=media:9000
MEDIA_ACCESS_KEY=CHANGE_ME_MEDIA_ACCESS_KEY
MEDIA_SECRET_KEY=CHANGE_ME_MEDIA_SECRET_KEY
MEDIA_BUCKET=profile-photos
MEDIA_PUBLIC_URL=https://priatelia.wondercules.com/profile-photos
MEDIA_SECURE=false

NOTIFICATION_WORKER_BATCH_SIZE=10
NOTIFICATION_WORKER_POLL_SECONDS=2.0
NOTIFICATION_WORKER_MAX_ATTEMPTS=5
NOTIFICATION_WORKER_PROCESSING_TIMEOUT_SECONDS=300
