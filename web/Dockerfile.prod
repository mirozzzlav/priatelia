FROM node:22-slim AS build

WORKDIR /app/web

ARG VITE_DATA_SOURCE=rest
ARG VITE_API_BASE_URL=/api
ARG VITE_DISCOVERY_FEEDBACK_ENABLED=true
ARG VITE_PUBLIC_APP_URL=https://priatelia.wondercules.com
ENV VITE_DATA_SOURCE=$VITE_DATA_SOURCE
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_DISCOVERY_FEEDBACK_ENABLED=$VITE_DISCOVERY_FEEDBACK_ENABLED
ENV VITE_PUBLIC_APP_URL=$VITE_PUBLIC_APP_URL

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web .
COPY shared /app/shared
RUN npm run build

FROM nginx:1.27-alpine

COPY web/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html

EXPOSE 80
